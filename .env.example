# Copy this file to .env and fill in the values. Never commit .env.

# From @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# From https://aistudio.google.com/apikey (free tier, no card needed)
GEMINI_API_KEY=

# Your Telegram user ID(s), comma-separated. Message the bot /start to see yours.
ALLOWED_USER_IDS=

# Optional. Main model and comma-separated fallbacks.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite

# Optional but usually needed: Netscape-format cookies.txt from a logged-in
# Instagram session (use a spare account, not your main one).
INSTAGRAM_COOKIES_FILE=cookies.txt

# Optional tuning
ENABLED_PLATFORMS=instagram,youtube,facebook
MAX_VIDEO_MIN=20
MAX_CONCURRENT_JOBS=2
MAX_VIDEO_MB=200
LOG_LEVEL=INFO
# Rotating log file; set empty to log to stdout only (the server uses journald).
LOG_FILE=bot.log

# Optional: folder for files the bot writes (settings.json, prefs.json). Defaults to this folder.
# DATA_DIR=
